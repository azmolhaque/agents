# Copy to .env and fill in. NEVER commit .env.
#   chmod 0600 .env   (the systemd unit reads it via EnvironmentFile=)
# Every value here is redacted from logs by cindraleads.logging.redact_processor.

ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- storage ---------------------------------------------------------------
# On the Pi these must live on NVMe. SQLite under WAL load will corrupt on microSD.
DB_PATH=var/cindraleads.db
LOG_DIR=var/log
CACHE_DIR=var/cache

# --- rationed resources ----------------------------------------------------
DAILY_CLOUD_USD_CAP=0.50
SERPAPI_QUOTA_SAFETY_FRACTION=0.85
# Approved deviation from the master prompt's "<=2/domain/day", which contradicted
# its own 5-path fetch list. See PLAN.md 2.5.
FETCH_BUDGET_PER_DOMAIN_24H=6
FETCH_MIN_INTERVAL_SECONDS=3.0

# --- API keys (Phase 2+) ---------------------------------------------------
SERPAPI_KEY=
# Optional, and worth setting. Unauthenticated GitHub is 60 requests an hour and 10
# searches a minute; a classic token with NO scopes at all raises it to 5,000/h. No
# scopes is the point -- every endpoint this project calls is public, and a token that
# can write is a token that can be misused if the Pi is compromised.
# `github_orgs` spends 21 requests per template run (one search plus one profile per
# org), so without this the hourly harvest is most of the unauthenticated budget.
GITHUB_TOKEN=

# --- cloud escalation tier (Phase 5) ---------------------------------------
# Plain `anthropic` SDK, not claude-agent-sdk. See PLAN.md 2.4.
ANTHROPIC_API_KEY=

# --- Discord (Phase 6) -----------------------------------------------------
DISCORD_WEBHOOK_HOT=
DISCORD_WEBHOOK_WARM=
DISCORD_WEBHOOK_DIGEST=
DISCORD_WEBHOOK_OPS=

# --- Discord feedback bot (Phase 8) ----------------------------------------
# Webhooks are write-only and cannot read reactions, so the Critic's feedback
# ingress needs a gateway bot. See PLAN.md 2.1.
DISCORD_BOT_TOKEN=

# --- prose -----------------------------------------------------------------
# Whether a Bengali angle may reach a card. Off, and the default is the decision:
# a 4B writing marketing Bengali reads as foreign to a native speaker, which is the
# opposite of what a Bengali card is for. Turn this on when a human-written template
# with slots replaces the model's prose, not before.
DISPATCH_BENGALI_ANGLE=false
