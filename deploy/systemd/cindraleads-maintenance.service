[Unit]
Description=CindraLeads nightly maintenance (decay, retirement, retention, resample)
Documentation=file:///home/pi/cindraleads/PLAN.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi
Group=pi
WorkingDirectory=/home/pi/cindraleads
EnvironmentFile=/home/pi/cindraleads/.env
ExecStart=/home/pi/cindraleads/.venv/bin/cindra maintain
# Backup after the purge, so the snapshot is of the database we intend to keep rather
# than of six months of rows that were about to be deleted. `-` prefix: a backup
# failure must not mark the maintenance run failed, because the retire/decay/purge
# work already committed and re-running it is not what a full disk needs.
ExecStart=-/home/pi/cindraleads/scripts/backup.sh

# The pass is a handful of SQLite statements and at most `resample_max` fetches.
# If it has not finished in ten minutes something is wedged, and a maintenance job
# holding the write lock is worse than a maintenance job that did not run.
TimeoutStartSec=600

# It writes to the database and the cache directory and nothing else.
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pi/cindraleads/var
PrivateTmp=true
NoNewPrivileges=true

# Well under the two-model inference envelope: this stage never loads a model.
MemoryMax=512M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
