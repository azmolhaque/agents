[Unit]
Description=CindraLeads daily digest of Tier C leads
Documentation=file:///home/pi/cindraleads/docs/RUNBOOK.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi
Group=pi
SupplementaryGroups=video
WorkingDirectory=/home/pi/cindraleads
EnvironmentFile=/home/pi/cindraleads/.env
ExecStart=/home/pi/cindraleads/.venv/bin/cindra digest
TimeoutStartSec=300

MemoryMax=512M
CPUQuota=50%
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pi/cindraleads/var
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
